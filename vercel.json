{
    "version": 2,
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4"
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "overrides": {
        "package.json": {
            "buildCommand": "amazon-linux-extras install php8.2 -y && composer install --no-dev && npm run build"
        }
    }
}
